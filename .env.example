# Copy this file to `.env` and fill in your values. `.env` is git-ignored — never commit real keys.
# Local database settings live in `.env.local` (also git-ignored), which wins over `.env`.

# ── Database ──────────────────────────────────────────────────────────────────
# Local: `npm run db:up` starts Postgres in Docker with these credentials.
DATABASE_URL=postgres://firstreply:firstreply@localhost:5432/firstreply
# 32 random bytes, base64 — encrypts merchant PayPal secrets. Generate: openssl rand -base64 32
ENCRYPTION_KEY=
# Merchant console password for owner@trailhead.test. If empty, `npm run db:seed` generates one into .env.local.
DEMO_OWNER_PASSWORD=

# ── PayPal sandbox ────────────────────────────────────────────────────────────
# developer.paypal.com → Apps & Credentials → Sandbox → your app
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# ── LLM gateway ───────────────────────────────────────────────────────────────
# Which API format to speak to your gateway: "openai" or "anthropic"
LLM_PROTOCOL=openai
# OpenAI format: the URL that `/chat/completions` is appended to, e.g. https://your-gateway.example.com/v1
# Anthropic format: the URL that `/messages` is appended to, e.g. https://your-gateway.example.com/v1
LLM_BASE_URL=
# Optional: a different base URL for the Anthropic format, if your gateway uses another path for it
LLM_ANTHROPIC_BASE_URL=
LLM_API_KEY=
# Model ID exactly as your gateway names it
LLM_MODEL=
